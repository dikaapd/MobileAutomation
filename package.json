{
  "name": "belajarbareng-apps-automation",
  "version": "1.0.0",
  "description": "Automation test BelajarBarengApps (WebdriverIO + Appium + Mocha + Allure)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.20"
  },
  "scripts": {
    "setup:driver": "appium driver install uiautomator2",
    "test": "wdio run ./wdio.conf.js",
    "test:login": "wdio run ./wdio.conf.js --spec test/specs/login.spec.js",
    "test:post": "wdio run ./wdio.conf.js --spec test/specs/post.spec.js",
    "report:serve": "allure serve allure-results",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "pdf": "node scripts/build-submission-pdf.js"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.30.0",
    "appium": "^2.11.0",
    "dotenv": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "webdriverio": "^9.0.0"
  }
}
